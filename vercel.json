{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/"
    },
    {
      "source": "/profile-lite",
      "destination": "/"
    },
    {
      "source": "/profile-old",
      "destination": "/"
    },
    {
      "source": "/profile/mandalas",
      "destination": "/"
    },
    {
      "source": "/profile/courses",
      "destination": "/"
    },
    {
      "source": "/profile/photos",
      "destination": "/"
    },
    {
      "source": "/profile/profile",
      "destination": "/"
    },
    {
      "source": "/profile/services",
      "destination": "/"
    },
    {
      "source": "/profile/orders",
      "destination": "/"
    },
    {
      "source": "/profile/chats",
      "destination": "/"
    },
    {
      "source": "/profile/settings",
      "destination": "/"
    },
    {
      "source": "/shop",
      "destination": "/"
    },
    {
      "source": "/services/:serviceId",
      "destination": "/"
    },
    {
      "source": "/masters",
      "destination": "/"
    },
    {
      "source": "/masters/:id",
      "destination": "/"
    },
    {
      "source": "/feed",
      "destination": "/"
    },
    {
      "source": "/profile/admin",
      "destination": "/"
    }
  ]
}
