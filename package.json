{
  "type": "module",
  "scripts": {
    "dev": "npm run patch:issue72 && vite --host 0.0.0.0",
    "build": "npm run patch:issue72 && vite build",
    "patch:issue72": "node scripts/apply-issue72-profile-ux.mjs",
    "supabase:migrations:apply": "node scripts/apply-reiki-supabase-migrations.mjs",
    "test:profile-media": "npm run patch:issue72 && node test/profileMediaClient.test.mjs",
    "test:profile-materials": "npm run patch:issue72 && node test/profileMaterials.test.mjs",
    "test:power-place": "npm run patch:issue72 && node test/powerPlaceClient.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "validate:knowledge": "node scripts/validate-knowledge-base.mjs",
    "validate:videos": "node scripts/validate-reiki-step-videos.mjs",
    "validate:free-courses": "node scripts/validate-free-course-links.mjs",
    "check": "npm run patch:issue72 && npm run test:profile-materials && npm run test:power-place && npm run test:profile-media && npm run validate:knowledge && npm run validate:videos && npm run validate:free-courses && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "postcss": "latest",
    "autoprefixer": "latest",
    "supabase": "^2.101.0"
  }
}
